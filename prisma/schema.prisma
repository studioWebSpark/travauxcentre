generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooler (port 6543) pour les requêtes
  directUrl = env("DIRECT_URL")     // connexion directe (port 5432) pour les migrations
}

// ─── NextAuth.js ─────────────────────────────────────────────────────────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Utilisateurs ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null pour les comptes OAuth
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  clientProfile  ClientProfile?
  artisanProfile ArtisanProfile?
  messagesSent   Message[]       @relation("expediteur")
  messagesRecus  Message[]       @relation("destinataire")
}

model ClientProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  telephone String?
  adresse   String?
  ville     String?
  codePostal String?

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projets Projet[]
  avis    Avis[]
}

model ArtisanProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  siret       String?
  description String?
  telephone   String?
  adresse     String?
  ville       String?
  codePostal  String?
  rayon       Int      @default(30) // km autour de sa position
  disponible  Boolean  @default(true)
  note        Float    @default(0)
  nbAvis      Int      @default(0)
  verifie     Boolean  @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialites  Specialite[]
  devis        Devis[]
  chantiers    Chantier[]
  avis         Avis[]
}

// ─── Mise en relation ────────────────────────────────────────────────────────

model Projet {
  id          String       @id @default(cuid())
  clientId    String
  titre       String
  description String
  categorie   Categorie
  adresse     String
  ville       String
  codePostal  String
  budgetMin   Float?
  budgetMax   Float?
  dateDebut   DateTime?
  dateFin     DateTime?
  statut      StatutProjet @default(OUVERT)
  photos      String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  devis    Devis[]
  chantier Chantier?
  messages Message[]
}

model Devis {
  id          String       @id @default(cuid())
  projetId    String
  artisanId   String
  montant     Float
  description String
  dureeJours  Int
  statut      StatutDevis  @default(EN_ATTENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projet   Projet         @relation(fields: [projetId], references: [id], onDelete: Cascade)
  artisan  ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  chantier Chantier?

  @@unique([projetId, artisanId])
}

model Avis {
  id          String   @id @default(cuid())
  clientId    String
  artisanId   String
  chantierId  String   @unique
  note        Int      // 1 à 5
  commentaire String?
  createdAt   DateTime @default(now())

  client   ClientProfile  @relation(fields: [clientId], references: [id])
  artisan  ArtisanProfile @relation(fields: [artisanId], references: [id])
  chantier Chantier       @relation(fields: [chantierId], references: [id])
}

// ─── Gestion de chantier ─────────────────────────────────────────────────────

model Chantier {
  id         String        @id @default(cuid())
  projetId   String        @unique
  devisId    String        @unique
  artisanId  String
  statut     StatutChantier @default(PLANIFIE)
  dateDebut  DateTime?
  dateFin    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  projet    Projet         @relation(fields: [projetId], references: [id])
  devis     Devis          @relation(fields: [devisId], references: [id])
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id])
  taches    Tache[]
  rapports  Rapport[]
  documents Document[]
  avis      Avis?
}

model Tache {
  id           String      @id @default(cuid())
  chantierId   String
  titre        String
  description  String?
  statut       StatutTache @default(A_FAIRE)
  ordre        Int         @default(0)
  dateEcheance DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  chantier Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

model Rapport {
  id          String   @id @default(cuid())
  chantierId  String
  auteurId    String
  description String
  photos      String[]
  createdAt   DateTime @default(now())

  chantier Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

model Document {
  id         String       @id @default(cuid())
  chantierId String
  nom        String
  type       TypeDocument
  url        String
  createdAt  DateTime     @default(now())

  chantier Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

// ─── Messagerie ──────────────────────────────────────────────────────────────

model Message {
  id             String   @id @default(cuid())
  expediteurId   String
  destinataireId String
  projetId       String?
  contenu        String
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  expediteur   User    @relation("expediteur", fields: [expediteurId], references: [id])
  destinataire User    @relation("destinataire", fields: [destinataireId], references: [id])
  projet       Projet? @relation(fields: [projetId], references: [id])
}

// ─── Spécialités artisan ─────────────────────────────────────────────────────

model Specialite {
  id        String    @id @default(cuid())
  artisanId String
  categorie Categorie

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([artisanId, categorie])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ARTISAN
  ADMIN
}

enum Categorie {
  MACONNERIE
  PLOMBERIE
  ELECTRICITE
  PEINTURE
  MENUISERIE
  TOITURE
  CARRELAGE
  ISOLATION
  CHAUFFAGE
  CLIMATISATION
  JARDINAGE
  RENOVATION_GENERALE
  AUTRE
}

enum StatutProjet {
  OUVERT
  EN_COURS
  TERMINE
  ANNULE
}

enum StatutDevis {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

enum StatutChantier {
  PLANIFIE
  EN_COURS
  PAUSE
  TERMINE
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  TERMINEE
}

enum TypeDocument {
  CONTRAT
  FACTURE
  PHOTO
  AUTRE
}

// ─── CRM — Leads & Pipeline ──────────────────────────────────────────────────

enum StatutLead {
  NOUVEAU
  CONTACTE
  DEVIS_ENVOYE
  GAGNE
  PERDU
  EN_ATTENTE
}

enum PrioriteLead {
  HAUTE
  NORMALE
  BASSE
}

model Lead {
  id               String       @id @default(cuid())
  nom              String
  email            String
  telephone        String
  ville            String
  codePostal       String
  typeTravaux      String
  description      String
  surface          Float?
  budget           String?
  dateSouhaitee    String?
  source           String?
  facebookUrl      String?

  // CRM
  statut           StatutLead   @default(NOUVEAU)
  priorite         PrioriteLead @default(NORMALE)
  montantDevis     Float?
  dateContact      DateTime?
  dateRdv          DateTime?
  commentaireInterne String?

  hubspotContactId String?
  hubspotDealId    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  notes            NoteLead[]
  plannings        Planning[]
  chantiers        ChantierCrm[]
  devis            DevisCrm[]
  envoisCampagne   EnvoiCampagne[]
}

model EmailTemplate {
  id        String   @id @default(cuid())
  nom       String
  sujet     String
  corpsHtml String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampagneMarketing {
  id        String          @id @default(cuid())
  nom       String
  sujet     String
  corpsHtml String
  createdAt DateTime        @default(now())

  envois    EnvoiCampagne[]
}

model EnvoiCampagne {
  id         String            @id @default(cuid())
  campagneId String
  leadId     String
  email      String
  statut     String            @default("ENVOYE") // ENVOYE | ECHEC
  erreur     String?
  envoyeAt   DateTime          @default(now())

  campagne   CampagneMarketing @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  lead       Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model NoteLead {
  id        String   @id @default(cuid())
  leadId    String
  contenu   String
  auteur    String   @default("Équipe")
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ─── Planning & Rendez-vous clients ──────────────────────────────────────────

enum StatutPlanning {
  EN_ATTENTE
  CONFIRME
  ANNULE
}

model Planning {
  id        String         @id @default(cuid())
  leadId    String
  date      DateTime
  duree     Int            @default(60)   // minutes
  typeRdv   String
  adresse   String?
  notes     String?
  statut    StatutPlanning @default(EN_ATTENTE)
  token     String         @unique @default(cuid())
  createdAt DateTime       @default(now())

  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ─── CRM Chantiers ───────────────────────────────────────────────────────────

enum StatutChantierCrm {
  PLANIFIE
  EN_COURS
  PAUSE
  TERMINE
  ANNULE
}

enum CategoriePhoto {
  AVANT
  PENDANT
  APRES
}

model ChantierCrm {
  id           String            @id @default(cuid())
  leadId       String?
  titre        String
  description  String?
  adresse      String
  budget       Float?
  budgetReel   Float?
  dateDebut    DateTime?
  dateFin      DateTime?
  statut       StatutChantierCrm @default(PLANIFIE)
  progression  Int               @default(0)
  tokenClient  String            @unique @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  etapes     EtapeChantierCrm[]
  photos     PhotoChantierCrm[]
  notes      NoteChantierCrm[]
  devis      DevisCrm[]
  factures   FactureCrm[]
  depenses   DepenseChantier[]
  rapports   RapportJournalier[]
}

model DepenseChantier {
  id          String      @id @default(cuid())
  chantierId  String
  type        String      @default("MATERIAUX")
  description String
  montant     Float
  fournisseur String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())

  chantier    ChantierCrm @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

model RapportJournalier {
  id          String      @id @default(cuid())
  chantierId  String
  date        DateTime    @default(now())
  heures      Float       @default(0)
  description String
  meteo       String?
  envoye      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  chantier    ChantierCrm @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

model EtapeChantierCrm {
  id           String      @id @default(cuid())
  chantierId   String
  titre        String
  description  String?
  ordre        Int         @default(0)
  statut       String      @default("A_FAIRE")
  dateEcheance DateTime?
  createdAt    DateTime    @default(now())

  chantier     ChantierCrm @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

model PhotoChantierCrm {
  id          String         @id @default(cuid())
  chantierId  String
  url         String
  categorie   CategoriePhoto @default(PENDANT)
  description String?
  createdAt   DateTime       @default(now())

  chantier    ChantierCrm    @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

model NoteChantierCrm {
  id         String      @id @default(cuid())
  chantierId String
  contenu    String
  auteur     String      @default("Équipe")
  createdAt  DateTime    @default(now())

  chantier   ChantierCrm @relation(fields: [chantierId], references: [id], onDelete: Cascade)
}

// ─── CRM Devis & Factures ────────────────────────────────────────────────────

model DevisCrm {
  id           String          @id @default(cuid())
  numero       String          @unique
  leadId       String?
  chantierId   String?
  dateEmission DateTime        @default(now())
  dateValidite DateTime?
  statut       String          @default("BROUILLON")
  tva          Float           @default(0.20)
  notes        String?
  token        String          @unique @default(cuid())
  emailEnvoye  Boolean         @default(false)
  dateAccepte  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  lead         Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  chantier     ChantierCrm?         @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  lignes       LigneDevisCrm[]
  etapesPaiement EtapePaiementDevis[]
  factures     FactureCrm[]
}

model LigneDevisCrm {
  id           String   @id @default(cuid())
  devisId      String
  description  String
  quantite     Float    @default(1)
  unite        String   @default("forfait")
  prixUnitaire Float

  devis        DevisCrm @relation(fields: [devisId], references: [id], onDelete: Cascade)
}

model EtapePaiementDevis {
  id           String   @id @default(cuid())
  devisId      String
  pourcentage  Float    // 20, 40, 60, etc.
  description  String?  // "À la signature", "À la fin", etc.
  dateEcheance DateTime?
  statut       String   @default("ATTENTE")  // ATTENTE, PAYEE
  datePaiement DateTime?
  ordre        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devis        DevisCrm @relation(fields: [devisId], references: [id], onDelete: Cascade)
}

model FactureCrm {
  id           String           @id @default(cuid())
  numero       String           @unique
  chantierId   String?
  devisId      String?
  dateEmission DateTime         @default(now())
  dateEcheance DateTime?
  type         String           @default("FACTURE")
  statut       String           @default("BROUILLON")
  tva          Float            @default(0.20)
  notes        String?
  emailEnvoye  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  chantier     ChantierCrm?     @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  devis        DevisCrm?        @relation(fields: [devisId], references: [id], onDelete: SetNull)
  lignes       LigneFactureCrm[]
}

model LigneFactureCrm {
  id           String     @id @default(cuid())
  factureId    String
  description  String
  quantite     Float      @default(1)
  unite        String     @default("forfait")
  prixUnitaire Float

  facture      FactureCrm @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

// ─── Veille marché ───────────────────────────────────────────────────────────

model VeilleAnnonce {
  id           String   @id @default(cuid())
  source       String   // "leboncoin" | "allovoisin" | "facebook" | "manuel"
  titre        String
  description  String
  url          String?
  ville        String?
  prix         String?
  score        Int      @default(0)
  resume       String?
  budgetEstime String?
  typeTravaux  String?
  statut       String   @default("NOUVEAU")
  leadId       String?
  createdAt    DateTime @default(now())
}

// ─── XP & Gamification ───────────────────────────────────────────────────────

model XpEvent {
  id        String   @id @default(cuid())
  type      String   // LEAD_CONTACTE | DEVIS_ENVOYE | DEAL_GAGNE | NOTE_AJOUTEE | EMAIL_ENVOYE | OBJECTIF_JOUR | OBJECTIF_SEMAINE | OBJECTIF_MOIS
  points    Int
  leadId    String?
  label     String?
  createdAt DateTime @default(now())
}

model RendezVous {
  id               String   @id @default(cuid())
  nom              String
  email            String
  telephone        String
  typeRdv          String
  message          String?
  creneau          String?
  hubspotTaskId    String?
  createdAt        DateTime @default(now())
}

model CrmUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  resetToken    String?   @unique
  resetExpiry   DateTime?
  createdAt     DateTime  @default(now())
}
